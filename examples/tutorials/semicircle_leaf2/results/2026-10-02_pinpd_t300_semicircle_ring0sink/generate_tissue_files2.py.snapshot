import math
import random

# Last modified: 2026-09-08
#
# Full PIN + PD auxin canalization model (Holloway, Eiriksson & Wenzel 2025,
# Front. Plant Sci. 16:1621815), implemented on a rectangular corn-leaf tissue.
#
# Geometry: nRows × nCols rectangular grid of square cells, centered at x=0.
#   y=0 is the leaf base (sink row), y=nRows*dy is the leaf tip (source row).
#   GrowthForce::Y elongates the blade apically; GrowthForce::X is kept small
#   to maintain a narrow blade shape.
#
# Cell variables:
#   0 = volume tracker (for Division::ShortestPath2D)
#   1 = type (0 = normal, 1 = source, 2 = sink)
#   2 = Aprec (auxin precursor; ramps in source cells, drives auxin production
#              when Aprec > 0; negative = developmental timer only)
#   3 = A (auxin)
#   4 = P (PIN, cytoplasmic)
#
# Wall variables (index 0 is always the built-in rest length):
#   1, 2 = Pij, Pji (PIN membrane pair, directional)
#   3, 4 = Dij, Dij_mirror (plasmodesmata area, kept equal — symmetric pores)
#   5, 6 = saved PIN-transport flux pair (directional), feeds the WTF term
#
# ── Source / sink geometry ────────────────────────────────────────────────────
# Source (type 1): N_SOURCES clusters of SOURCE_WIDTH cells each, evenly spaced
#   along the top row (leaf tip margin). source_ranges() computes positions.
#
# Sink (type 2): entire bottom row (row 0, y≈0 = leaf base / vascular bundle).
#   Auxin drains here, pulling veins from tip to base — parallel venation.
#
# Staggered activation (Holloway & Wenzel 2021, section 2.3):
#   ZONE_APREC encodes initial Aprec per cluster (left → right).
#   Aprec ramps at aprec_ramp/tu in all source cells; auxin production fires
#   only when Aprec > 0 (Creation::One clips at zero).
# ─────────────────────────────────────────────────────────────────────────────

N_SOURCES    = 5    # number of source clusters along the tip margin
SOURCE_WIDTH = 1    # width in columns of each source cluster (narrow for corn)
SINK_BASE    = True # bottom row (row 0) is the auxin sink


def source_ranges(nCols, n_sources=N_SOURCES, width=SOURCE_WIDTH):
    """Return [(start_col, end_col), ...] for n evenly-spaced source clusters.

    Gaps between clusters (and at the two ends) are as equal as possible.
    Works for any nCols >= n_sources * width.
    """
    gap = (nCols - n_sources * width) / (n_sources + 1)
    ranges = []
    for k in range(n_sources):
        start = round((k + 1) * gap + k * width)
        ranges.append((start, start + width - 1))
    return ranges


def createSemicircle(nRings, nCols, outputName,
                     n_sources=N_SOURCES,
                     source_width=SOURCE_WIDTH,
                     sink_base=SINK_BASE,
                     zone_aprec=None):

    R_max = 10.0
    radii = [R_max * (r+1) / nRings for r in range(nRings)]
    angles = [i * math.pi / nCols for i in range(nCols + 1)]

    verts = []
    # 1. Create the base vertices evenly spaced along the FLAT bottom axis (y = 0).
    # This prevents MoveVertexRadially from warping a curved inner arc into the flat zone.
    for i in range(nCols + 1):
        x_flat = - (radii[0] * 0.1) + i * ((2 * radii[0] * 0.1) / nCols)
        verts.append((x_flat, 0.0))

    # 2. Create the concentric rings (true arcs)
    for r in range(nRings):
        R = radii[r]
        for i in range(nCols + 1):
            a = angles[i]
            verts.append((-R * math.cos(a), R * math.sin(a)))

    nVerts = len(verts)
    nCells = nRings * nCols

    def base_vert(i):   return i
    def arc_vert(r, i): return (r+1)*(nCols+1) + i
    def cell_idx(r, c): return r * nCols + c

    walls = []
    for c in range(nCols):
        walls.append((-1, cell_idx(0,c), base_vert(c), base_vert(c+1)))
    for r in range(nRings-1):
        for c in range(nCols):
            walls.append((cell_idx(r,c), cell_idx(r+1,c), arc_vert(r,c), arc_vert(r,c+1)))
    for c in range(nCols):
        r = nRings-1
        walls.append((-1, cell_idx(r,c), arc_vert(r,c), arc_vert(r,c+1)))
    for r in range(nRings):
        v_inner = base_vert(0) if r==0 else arc_vert(r-1,0)
        walls.append((-1, cell_idx(r,0), v_inner, arc_vert(r,0)))
    for r in range(nRings):
        for c in range(1, nCols):
            v_inner = base_vert(c) if r==0 else arc_vert(r-1,c)
            walls.append((cell_idx(r,c-1), cell_idx(r,c), v_inner, arc_vert(r,c)))
    for r in range(nRings):
        v_inner = base_vert(nCols) if r==0 else arc_vert(r-1,nCols)
        walls.append((-1, cell_idx(r,nCols-1), v_inner, arc_vert(r,nCols)))

    nWalls = len(walls)

    # Initial wall values: PIN pair = 0, Dij seeded nonzero (PD transport/feedback
    # is inert while Dij<=0, see DiffusionConductiveSimple), flux-save pair = 0.
    Dij_init = 0.5

    # Initial cell values
    volume_init = 0.9
    PIN_cytoplasmic_init = 0.1

    sources = source_ranges(nCols, n_sources, source_width)

    # zone_aprec[k] = initial Aprec for cluster k (0 = left-most).
    # Negative values act as developmental timers: the cluster activates when
    # Aprec crosses zero under the aprec_ramp.  Default: all clusters active
    # immediately (paper Z1 value = 0.5).
    if zone_aprec is None:
        zone_aprec = [0.5] * n_sources

    # Build a column → cluster-index map for the outermost ring.
    col_to_cluster = {}
    for k, (s, e) in enumerate(sources):
        for col in range(s, e + 1):
            col_to_cluster[col] = k

    with open(outputName, 'w') as f:
        f.write(f"{nCells} {nWalls} {nVerts}\n")
        for idx, (c1,c2,v1,v2) in enumerate(walls):
            f.write(f" {idx} {c1} {c2} {v1} {v2}\n")
        f.write(" \n")
        f.write(f" {nVerts} 2\n")
        for (x,y) in verts:
            f.write(f"{x:.6f} {y:.6f}\n")
        # 6 wall variables beyond built-in length: Pij Pji Dij Dij_mirror flux_ij flux_ji
        # Boundary walls (c1==-1 or c2==-1) get Dij=0: no PD pores on the leaf surface.
        f.write(f"\n{nWalls} 1 6\n ")
        for (c1,c2,v1,v2) in walls:
            vx1,vy1 = verts[v1]
            vx2,vy2 = verts[v2]
            rest = math.sqrt((vx2-vx1)**2+(vy2-vy1)**2)
            Dij_wall = 0.0 if (c1 == -1 or c2 == -1) else Dij_init
            f.write(f"{rest:.6f} 0.0 0.0 {Dij_wall} {Dij_wall} 0.0 0.0\n")
        f.write(f"\n{nCells} 5\n")
        for r in range(nRings):
            for c in range(nCols):
                is_source = (r == nRings - 1) and any(s <= c <= e for s, e in sources)
                is_sink   = sink_base and (r == 0)
                if is_source:
                    cellType = 1
                elif is_sink:
                    cellType = 2
                else:
                    cellType = 0
                if cellType == 1:
                    aprec = zone_aprec[col_to_cluster[c]]
                else:
                    aprec = 0.0
                f.write(f"{volume_init} {cellType} {aprec} 0.0 {PIN_cytoplasmic_init}\n")

    print(f"Written {outputName}: {nCells} cells, {nWalls} walls, {nVerts} vertices")
    print(f"  Source clusters (outermost ring, cols): {sources}")
    zone_summary = {k: zone_aprec[k] for k in range(n_sources)}
    print(f"  Zone Aprec at t=0: {zone_summary}")
    print(f"  Sink: base row (ring 0, all {nCols} columns)")


def createRectangle(nRows, nCols, outputName,
                    dx=1.0, dy=1.0,
                    n_sources=N_SOURCES,
                    source_width=SOURCE_WIDTH,
                    sink_base=SINK_BASE,
                    zone_aprec=None):
    """Create a rectangular corn-leaf tissue.

    nRows tall × nCols wide grid of square cells.
    y=0 is the leaf base (sink), y=nRows*dy is the leaf tip (sources).
    Tissue is horizontally centered at x=0.
    """
    x0 = -nCols * dx / 2.0   # left edge x-coordinate

    def vert_idx(i, j): return j * (nCols + 1) + i
    def cell_idx(r, c): return r * nCols + c

    nVerts = (nRows + 1) * (nCols + 1)
    nCells = nRows * nCols

    verts = [(x0 + i * dx, j * dy)
             for j in range(nRows + 1)
             for i in range(nCols + 1)]

    walls = []
    # Bottom boundary (below row 0)
    for c in range(nCols):
        walls.append((-1, cell_idx(0, c), vert_idx(c, 0), vert_idx(c+1, 0)))
    # Internal horizontal walls (between rows r and r+1)
    for r in range(nRows - 1):
        for c in range(nCols):
            walls.append((cell_idx(r, c), cell_idx(r+1, c), vert_idx(c, r+1), vert_idx(c+1, r+1)))
    # Top boundary (above row nRows-1)
    for c in range(nCols):
        walls.append((-1, cell_idx(nRows-1, c), vert_idx(c, nRows), vert_idx(c+1, nRows)))
    # Left boundary (left of col 0)
    for r in range(nRows):
        walls.append((-1, cell_idx(r, 0), vert_idx(0, r), vert_idx(0, r+1)))
    # Internal vertical walls (between cols c-1 and c)
    for r in range(nRows):
        for c in range(1, nCols):
            walls.append((cell_idx(r, c-1), cell_idx(r, c), vert_idx(c, r), vert_idx(c, r+1)))
    # Right boundary (right of col nCols-1)
    for r in range(nRows):
        walls.append((-1, cell_idx(r, nCols-1), vert_idx(nCols, r), vert_idx(nCols, r+1)))

    nWalls = len(walls)
    Dij_init = 0.5
    volume_init = dx * dy * 0.9   # slightly below actual cell area
    PIN_cytoplasmic_init = 0.1

    sources = source_ranges(nCols, n_sources, source_width)

    if zone_aprec is None:
        zone_aprec = [0.5] * n_sources

    col_to_cluster = {}
    for k, (s, e) in enumerate(sources):
        for col in range(s, e + 1):
            col_to_cluster[col] = k

    with open(outputName, 'w') as f:
        f.write(f"{nCells} {nWalls} {nVerts}\n")
        for idx, (c1, c2, v1, v2) in enumerate(walls):
            f.write(f" {idx} {c1} {c2} {v1} {v2}\n")
        f.write(" \n")
        f.write(f" {nVerts} 2\n")
        for (x, y) in verts:
            f.write(f"{x:.6f} {y:.6f}\n")
        # 6 wall variables: Pij Pji Dij Dij_mirror flux_ij flux_ji
        # Boundary walls get Dij=0 (no PD pores on leaf surface).
        f.write(f"\n{nWalls} 1 6\n ")
        for (c1, c2, v1, v2) in walls:
            vx1, vy1 = verts[v1]
            vx2, vy2 = verts[v2]
            rest = math.sqrt((vx2-vx1)**2 + (vy2-vy1)**2)
            Dij_wall = 0.0 if (c1 == -1 or c2 == -1) else Dij_init
            f.write(f"{rest:.6f} 0.0 0.0 {Dij_wall} {Dij_wall} 0.0 0.0\n")
        f.write(f"\n{nCells} 5\n")
        for r in range(nRows):
            for c in range(nCols):
                is_source = (r == nRows - 1) and any(s <= c <= e for s, e in sources)
                is_sink   = sink_base and (r == 0)
                if is_source:
                    cellType = 1
                elif is_sink:
                    cellType = 2
                else:
                    cellType = 0
                aprec = zone_aprec[col_to_cluster[c]] if cellType == 1 else 0.0
                f.write(f"{volume_init} {cellType} {aprec} 0.0 {PIN_cytoplasmic_init}\n")

    print(f"Written {outputName}: {nCells} cells, {nWalls} walls, {nVerts} vertices")
    print(f"  Tissue: {nRows} rows × {nCols} cols, cell size {dx}×{dy}")
    print(f"  Source clusters (top row, cols): {sources}")
    print(f"  Zone Aprec at t=0: { {k: zone_aprec[k] for k in range(n_sources)} }")
    print(f"  Sink: {'base row (row 0, all columns)' if sink_base else 'none'}")


# Aprec at t=0 per source cluster (left to right).
# Negative = developmental timer: cluster activates when Aprec crosses 0 under aprec_ramp.
# With aprec_ramp=0.02: offset of -1.0 → delay of 50 time units; -2.0 → 100 tu.
#   Z1 (center, cluster 2): active immediately (midvein)
#   Z2 (flanking, clusters 1 & 3): activates at t≈50  (1st secondary veins)
#   Z3 (outer, clusters 0 & 4): activates at t≈100 (2nd secondary veins)
ZONE_APREC = [-2.0, -1.0, 0.5, -1.0, -2.0]

# Semicircle tissue: 10 rings × 50 cols = 500 cells
# Sink = all cells whose centroid y <= ring-0 center height (~0.55)
# This covers ring-0 (all cols) + outer-ring edge cells near y=0.
createSemicircle(
    nRings=10, nCols=50,
    outputName="semicircle_leaf2.init",
    n_sources=N_SOURCES,
    source_width=SOURCE_WIDTH,
    sink_base=SINK_BASE,
    zone_aprec=ZONE_APREC,
)


# Reaction parameters — corn-leaf rectangular model.
# Key changes from previous run (semicircle 10×50, staggered):
#   - Geometry: rectangular grid (12 cols × 40 rows) instead of semicircle
#   - SOURCE_WIDTH: 5 cols → 1 col (single-cell-wide source zones, corn-like)
#   - k_growth_x: 0.002 → 0.001 (slow lateral growth, keeps blade narrow)
#   - k_growth_y: 0.006 → 0.004 (apical elongation, blade gets taller)
#   - Staggered zone activation unchanged (Z1 t=0, Z2 t≈50, Z3 t≈100)
params = {
    "k_growth_x": 0.001,   # slow lateral growth — keeps corn leaf narrow
    "k_growth_y": 0.004,   # apical elongation growth
    "k_growth_wall":   0.048,
    "K_spring":        0.01,
    "K_adh":           1.0,
    # Eq1: auxin
    "auxpr":       0.05,   # production rate from Aprec
    "auxdec":      0.01,   # background decay
    "auxdec_sink": 0.15,   # extra decay at base sink row
    "aprec_ramp":  0.02,   # precursor ramp rate in source cells
    "T_pin":       6.0,    # PIN transport permeability (paper: 6)
    # Eq2: plasmodesmata (via DiffusionConductiveSimple, p3=0)
    "D_pd":             0.15,  # PD passive diffusion rate (paper: 0.8)
    "alpha_pd":         0.02,  # flux-feedback growth rate
    "gamma_over_alpha": 5.0,   # gamma/alpha ratio -> sets Dij ceiling
    "beta_pd":          0.02,  # background PD production on all walls
    # Eq3: PIN cytoplasmic
    "pinpr":  0.05,
    "pindec": 0.02,
    # Eq4: PIN allocation (UTG + WTF)
    "k_U":   0.1,
    "k_off": 0.05,
    "K_utg": 2.0,
    "k_Wq":  0.15,
    "k_Wl":  0.2,
    # Division / removal
    "V_threshold": 1.5,   # cells divide when volume > threshold; outer-ring divisions use type-inheritance
    "R_removal":   500.0,
}

model = f"""\
15
2
0
GrowthForce::X
2 0
{params['k_growth_x']}
1
GrowthForce::Y
2 0
{params['k_growth_y']}
1
WallGrowth::Stress
4 2 1 1
{params['k_growth_wall']}
0.0
1
1
0
1
VertexFromWallSpring
2 1 1
{params['K_spring']}
{params['K_adh']}
0
CenterCOM 0 0
Creation::FromType
2 2 1 1
{params['aprec_ramp']}
1
2
1
Creation::One
1 2 1 1
{params['auxpr']}
3
2
Degradation::One
1 1 1
{params['auxdec']}
3
Degradation::FromType
2 2 1 1
{params['auxdec_sink']}
2
3
1
PINSaturatingTransport
1 3 1 1 1
{params['T_pin']}
3
1
5
Diffusion::ConductiveSimple
5 3 1 2 2
{params['D_pd']}
{params['alpha_pd']}
2
0
{params['gamma_over_alpha']}
3
3
4
5
6
Creation::OneWall
1 1 2
{params['beta_pd']}
3
4
Creation::One
1 2 1 1
{params['pinpr']}
4
3
Degradation::One
1 1 1
{params['pindec']}
4
MembraneCycling::UTGWTF
5 3 2 1 1
{params['k_U']}
{params['k_off']}
{params['K_utg']}
{params['k_Wq']}
{params['k_Wl']}
3
4
1
5
Division::ShortestPath2D
5 1 1
{params['V_threshold']}
1.0
0.1
1
1
0
RemovalOutsideRadius
1 0
{params['R_removal']}
"""

with open("semicircle_leaf2.model", "w") as f:
    f.write(model)
print("Written semicircle_leaf2.model")


solver = """\
RK5Adaptive
0 300
2 150
0.5 1e-4
"""

with open("semicircle_leaf2.solver", "w") as f:
    f.write(solver)
print("Written semicircle_leaf2.solver")
